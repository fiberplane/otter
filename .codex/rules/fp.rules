# Allow routine fp CLI workflows in the Codex sandbox without allowing every fp
# subcommand. Commands not matched here will still prompt normally.
prefix_rule(
    pattern=["fp", ["issue", "issues", "i"], ["list", "show", "get", "create", "update", "edit", "diff", "files", "assign", "sessions"]],
    decision="allow",
    justification="allow issue tracking workflows used by agents",
    match=[
        "fp issue create --title Test",
        "fp issue update FP-123 --status done",
        "fp issues list --format json",
        "fp issues show FP-123",
        "fp i diff FP-123",
    ],
    not_match=[
        "fp issue delete FP-123",
        "fp issues delete FP-123",
        "fp i delete FP-123",
    ],
)
prefix_rule(
    pattern=["fp", ["comment", "comments", "c"], ["list", "add", "create"]],
    decision="allow",
    justification="allow issue comment reads and writes used by agents",
    match=[
        "fp comment list FP-123",
        "fp comment add FP-123 Done",
        "fp comments create FP-123 Done",
        "fp c list FP-123 --format json",
    ],
    not_match=[
        "fp comment delete comment-123",
        "fp comments delete comment-123",
        "fp c delete comment-123",
        "fp comment FP-123 Done",
    ],
)
prefix_rule(
    pattern=["fp", ["tree", "log", "logs", "context", "search"]],
    decision="allow",
    justification="allow read-only issue and project context commands",
    match=[
        "fp tree",
        "fp log FP-123",
        "fp logs --limit 50",
        "fp context FP-123",
        "fp search sync state",
    ],
    not_match=[
        "fp attach screenshot.png",
        "fp run FP-123",
        "fp update",
    ],
)
prefix_rule(
    pattern=["fp", ["project", "projects", "p"], ["list", "remote", "test-connection", "sync", "sync-all-projects"]],
    decision="allow",
    justification="allow project inspection and sync commands used by agents",
    match=[
        "fp project list",
        "fp projects remote",
        "fp p test-connection",
        "fp project remote",
        "fp project sync FP-123",
        "fp project sync-all-projects",
    ],
    not_match=[
        "fp project export",
        "fp project gc",
        "fp project import export.jsonl",
        "fp project db compact",
        "fp project unlink",
    ],
)

# Allow drift CLI for spec-to-code binding
prefix_rule(pattern=["drift"], decision="allow", justification="drift CLI for spec staleness checking and linking")

# Allow ast-grep for linting
prefix_rule(pattern=["sg"], decision="allow", justification="ast-grep CLI for custom TypeScript lint rules")

# Allow common git read commands
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")

# Allow bun commands
prefix_rule(pattern=["bun", "run"], decision="allow")
prefix_rule(pattern=["bun", "install"], decision="allow")
prefix_rule(pattern=["bun", "test"], decision="allow")
prefix_rule(pattern=["bun", "x"], decision="allow", justification="bunx for running package binaries like @ast-grep/cli")
prefix_rule(pattern=["bunx"], decision="allow", justification="bunx shorthand for bun x")
